# Большие артифакты — только на внешке (см. README.md)
*.iso
*.iso.0*
*.7z
*.exe
*.dll
*.sys
*.wim
payload/
build/
debs/
toolroot/
# ZIP поставки разрешаем ТОЛЬКО в artifacts/ (мелкие пакеты, < 100 КБ)
*.zip
*.zip.0*
!artifacts/**

# Секреты — НИКОГДА не коммитим
.env
*cookie*
*.netrc
credentials*
*_token*
.gh_token
.phx_gh_token
cred.sh
*.pem
*.key
*.p12
*.pfx

# Python-артефакты
__pycache__/
*.pyc
